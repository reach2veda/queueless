# ==================================================
# QUEUELESS FRONTEND ENVIRONMENT VARIABLES
# ==================================================

# Base URL pointing to the Express backend API
# Development: http://localhost:5000/api (or /api when using Vite proxy)
# Production: Set to your backend API URL (e.g. https://api.yourdomain.com/api) or /api for reverse proxies
VITE_API_BASE_URL=http://localhost:5000/api

# Real-time WebSocket / Socket.IO Server URL
# Development: http://localhost:5000
# Production: Set to your backend WebSocket host (e.g. https://api.yourdomain.com)
VITE_SOCKET_URL=http://localhost:5000

